# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key

# OpenRouter AI
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key

# LinkedIn OAuth (optional)
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id
EXPO_PUBLIC_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# RevenueCat (for in-app purchases)
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_api_key

# Job alerts (Cloudflare Worker backend)
EXPO_PUBLIC_JOB_ALERTS_URL=your_worker_url
EXPO_PUBLIC_JOB_ALERTS_KEY=your_worker_api_key
